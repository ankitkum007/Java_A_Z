<hibernate-configuration>

	<!-- a SessionFactory instance listed as /jndi/name -->
	<session-factory>
		<!-- Database connection setting -->
		<property name="hibernate.connection.driver_class">
			com.mysql.cj.jdbc.Driver</property>
		<property name="hibernate.connection.url">
			jdbc:mysql://localhost:3306/many_to_many</property>
		<property name="hibernate.connection.username">root</property>
		<property name="hibernate.connection.password">Rock@123</property>

		<!-- Hibernate Settings -->
		<property name="hibernate.dialect.MySQL8Dialect"></property>


		<property name="hibernate.show_sql">false</property>
		<property name="hibernate.format_sql">false</property>
		<property name="hibernate.use_sql_comments">false</property>
		
		<property name="hibernate.hbm2ddl.auto">update</property>


		<!--Mapping class-->
		
		<!--one_to_one-->
		<!--<mapping class="com.maven.demo.HIbernateConnection.oneToOne.Address" />
		<mapping class="com.maven.demo.HIbernateConnection.oneToOne.Student" />-->
		
		<!--one_to_many-->
		<mapping class="com.maven.demo.HIbernateConnection.manyToMany.Student" />
		<mapping class="com.maven.demo.HIbernateConnection.manyToMany.Club" />

	</session-factory>

</hibernate-configuration>